APP_NAME=Fidow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fidow
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ─── Providers IA ─────────────────────────────────────────────────────────────
GROQ_API_KEY=
MISTRAL_API_KEY=
GOOGLE_AI_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CEREBRAS_API_KEY=

# ─── RapidAPI ─────────────────────────────────────────────────────────────────
# Clé unique RapidAPI (valable pour toutes les APIs souscrites)
# → https://rapidapi.com/developer/apps — onglet "Security"
RAPIDAPI_KEY=

# APIs utilisées (plans gratuits disponibles) :
#   • linkedin-data-api.p.rapidapi.com  — Real-Time LinkedIn Scraper (RockApis)
#   • li-data-scraper.p.rapidapi.com    — LI Data Scraper (LiScraper)
#   • real-time-web-search.p.rapidapi.com — Real-Time Web Search (OpenWeb Ninja)
#   • job-salary-data.p.rapidapi.com    — Job Salary Data / commande digest:enrich-salary

# Mots-clés LinkedIn séparés par virgule (1 requête API par mot-clé)
# Adapter selon les domaines couverts par votre audience
RAPIDAPI_LINKEDIN_KEYWORDS="remote developer,remote designer,remote data scientist,remote marketing,remote product manager,remote devops"

# Requêtes Google Jobs séparées par | (cherche sur Greenhouse, Lever, Ashby…)
RAPIDAPI_WEBSEARCH_QUERIES="remote developer engineer jobs site:greenhouse.io OR site:lever.co OR site:jobs.ashbyhq.com|remote designer ux ui jobs site:greenhouse.io OR site:lever.co|remote data scientist machine learning jobs site:greenhouse.io OR site:lever.co|remote marketing seo growth jobs site:greenhouse.io OR site:lever.co"

# ─── Scraping proxies (optionnel) ─────────────────────────────────────────────
# Liste de proxies séparés par virgule pour le scraper Python headless
SCRAPING_PROXIES=
